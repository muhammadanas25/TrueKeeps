# Copy this file to .env and fill in the values
NODE_ENV=development
PORT=5001

# ── Database ────────────────────────────────────────────────────────
# Unset → in-memory storage (zero-setup; data dies with the process).
# Set   → Postgres via Drizzle. Works with local Postgres and Neon
#         (use Neon's POOLED connection string in prod).
# After setting it the first time, create/upgrade the tables with:
#   npm run db:migrate
# DATABASE_URL=postgresql://user:password@localhost:5432/truekeep_dev

# ── Media store (photo bytes) ───────────────────────────────────────
# All S3_* unset → local disk store at .local/media (dev default;
#                  survives restarts, served at /media/*).
# All S3_* set   → S3-compatible object storage. Built for Cloudflare
#                  R2 (zero egress); AWS S3 / MinIO also work.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=truekeep-media
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# Public base for serving objects (R2 public bucket domain or CDN):
# S3_PUBLIC_BASE_URL=https://media.yourdomain.com

# ── App origin / auth ───────────────────────────────────────────────
# Public origin of the app (OAuth callbacks, magic-link URLs, CORS, CSRF).
# Dev defaults to http://localhost:$PORT. Required in production.
# APP_URL=https://thetruekeeps.com
# ≥32 random bytes: openssl rand -base64 48. Required in production
# (dev falls back to a fixed insecure secret).
# BETTER_AUTH_SECRET=
# Google sign-in — omit both to hide the Google button.
# Redirect URI to register: $APP_URL/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Comma-separated emails that become admins on first sign-in.
# ADMIN_EMAILS=you@example.com

# ── Email ────────────────────────────────────────────────────────────
# Unset → messages (incl. magic-link URLs) are printed to the server log.
# RESEND_API_KEY=
# EMAIL_FROM="TrueKeep <hello@thetruekeeps.com>"

# ── Logging ──────────────────────────────────────────────────────────
# LOG_LEVEL=debug   # fatal|error|warn|info|debug|trace|silent

# ── Production (Railway) ────────────────────────────────────────────
# Full walkthrough: docs/deploy-railway.md
# Railway injects PORT — do not set it there. NODE_ENV=production,
# DATABASE_URL, APP_URL, BETTER_AUTH_SECRET and ALL S3_* vars are required
# in prod (the server refuses to boot without the first three; local-disk
# media on an ephemeral filesystem loses uploads on every deploy).
