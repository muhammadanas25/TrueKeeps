# Copy this file to .env and fill in the values
NODE_ENV=development
PORT=5001

# ── Database ────────────────────────────────────────────────────────
# Unset → in-memory storage (zero-setup; data dies with the process).
# Set   → Postgres via Drizzle. Works with local Postgres and Neon
#         (use Neon's POOLED connection string in prod).
# After setting it the first time, create/upgrade the tables with:
#   npm run db:migrate
# DATABASE_URL=postgresql://user:password@localhost:5432/truekeep_dev

# ── Media store (photo bytes) ───────────────────────────────────────
# All S3_* unset → local disk store at .local/media (dev default;
#                  survives restarts, served at /media/*).
# All S3_* set   → S3-compatible object storage. Built for Cloudflare
#                  R2 (zero egress); AWS S3 / MinIO also work.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=truekeep-media
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# The bucket must NOT be public: photos are read through /media/* with a
# short-lived signed link after an ownership check (docs/adr/011).

# ── App origin / auth ───────────────────────────────────────────────
# Public origin of the app (OAuth callbacks, magic-link URLs, CORS, CSRF).
# Dev defaults to http://localhost:$PORT. Required in production.
# APP_URL=https://thetruekeeps.com
# ≥32 random bytes: openssl rand -base64 48. Required in production
# (dev falls back to a fixed insecure secret).
# BETTER_AUTH_SECRET=
# Google sign-in — omit both to hide the Google button.
# Redirect URI to register: $APP_URL/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Comma-separated emails that become admins on first sign-in.
# ADMIN_EMAILS=you@example.com

# ── Email ────────────────────────────────────────────────────────────
# Unset → messages (incl. magic-link URLs) are printed to the server log.
# RESEND_API_KEY=
# EMAIL_FROM="TrueKeep <hello@thetruekeeps.com>"

# ── Payments (Safepay) ───────────────────────────────────────────────
# Sandbox dashboard: sandbox.api.getsafepay.com → Developer.
# API_KEY_SAFE_PAY=sec_...
# SAFE_PAY_SECRET_KEY=           # v1 secret
# SAFE_PAY_WEBHOOK_SECRET=       # Endpoints → View shared secret
# SAFE_PAY_API_URL=https://sandbox.api.getsafepay.com   # live: https://api.getsafepay.com
# Hosted checkout base — only set if Safepay's live URL differs from the
# default (sandbox: <API>/embedded/, live: https://getsafepay.com/embedded/)
# SAFE_PAY_CHECKOUT_URL=
# Webhook endpoint to register (events: payment.succeeded, payment.failed):
#   $APP_URL/api/payments/webhook/safepay
# With no Safepay keys: dev uses a local fake gateway; production disables checkout.

# ── Logging ──────────────────────────────────────────────────────────
# LOG_LEVEL=debug   # fatal|error|warn|info|debug|trace|silent

# ── Production (Railway) ────────────────────────────────────────────
# Full walkthrough: docs/deploy-railway.md
# Railway injects PORT — do not set it there. NODE_ENV=production,
# DATABASE_URL, APP_URL, BETTER_AUTH_SECRET and ALL S3_* vars are required
# in prod (the server refuses to boot without the first three; local-disk
# media on an ephemeral filesystem loses uploads on every deploy).

# ── Ops console (docs/adr/018) ───────────────────────────────────────
# The admin (/admin) needs DATABASE_URL. Staff sign in normally, then set up an
# authenticator app the first time they open /admin.
# Optional: only these IPs/prefixes may reach /api/admin (end a prefix with . or :)
# ADMIN_IP_ALLOWLIST=203.0.113.,198.51.100.7
# Optional: key for staff authenticator secrets (≥32 chars); defaults to one
# derived from BETTER_AUTH_SECRET. Changing it means staff set up again.
# STAFF_2FA_KEY=
# Staff alert emails used until a rule is saved in Admin → Notifications
# (default: every Owner account's email)
# ALERT_EMAILS=

# ── WhatsApp Cloud API (Meta) — all optional; without them WhatsApp is skipped
# WHATSAPP_TOKEN=               # permanent system-user token
# WHATSAPP_PHONE_NUMBER_ID=     # from WhatsApp Manager → API setup
# WHATSAPP_APP_SECRET=          # App settings → Basic → App secret (verifies webhooks)
# WHATSAPP_VERIFY_TOKEN=        # any string; type the same into Meta's webhook setup
# Webhook URL to register in Meta (field: messages): $APP_URL/api/webhooks/whatsapp
# WHATSAPP_API_VERSION=v21.0

# ── Second copy of every print PDF (optional, any S3-compatible bucket)
# S3_BACKUP_ENDPOINT=
# S3_BACKUP_REGION=auto
# S3_BACKUP_BUCKET=
# S3_BACKUP_ACCESS_KEY_ID=
# S3_BACKUP_SECRET_ACCESS_KEY=
